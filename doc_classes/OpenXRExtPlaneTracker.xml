<?xml version="1.0" encoding="UTF-8"?>
<class name="OpenXRExtPlaneTracker" inherits="XRPositionalTracker"
	experimental="Marked as experimental due to lack of community validation on devices such as the Magic Leap."
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Represents a plane tracker for the [OpenXRExtPlaneDetector].
	</brief_description>
	<description>
		Represents a plane tracker for the [OpenXRExtPlaneDetector].
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="set_plane_id">
			<return type="void" />
			<param index="0" name="plane_id" type="int" />
			<description>
				Sets the plane's ID.
			</description>
		</method>
		<method name="set_plane_space_location_flags">
			<return type="void" />
			<param index="0" name="plane_space_location_flags" type="int"
				enum="OpenXRExtPlaneTracker.PlaneSpaceLocationFlags" is_bitfield="true" default="0" />
			<description>
				Sets the plane's space location flags, which determines whether position and orientation are tracked and whether they are valid.
				This information must be OR'ed into the passed bit field.				
			</description>
		</method>
		<method name="set_plane_position">
			<return type="void" />
			<param index="0" name="plane_position" type="Vector3" />
			<description>
				Sets the plane's position.
			</description>
		</method>
		<method name="set_plane_rotation">
			<return type="void" />
			<param index="0" name="plane_rotation" type="Quaternion" />
			<description>
				Sets the plane's rotation.
			</description>
		</method>
		<method name="set_plane_width">
			<return type="void" />
			<param index="0" name="plane_width" type="float" />
			<description>
				Sets the plane's width in meters.
			</description>
		</method>
		<method name="set_plane_height">
			<return type="void" />
			<param index="0" name="plane_height" type="float" />
			<description>
				Sets the plane's height in meters.
			</description>
		</method>
		<method name="set_plane_orientation">
			<return type="void" />
			<param index="0" name="plane_orientation" type="int"
				enum="OpenXRExtPlaneTracker.PlaneOrientation" />
			<description>
				Sets the plane's orientation.
			</description>
		</method>
		<method name="set_plane_semantic_type">
			<return type="void" />
			<param index="0" name="plane_semantic_type" type="int"
				enum="OpenXRExtPlaneTracker.PlaneSemanticType" />
			<description>
				Sets the plane's semantic type.
			</description>
		</method>
		<method name="set_plane_polygon_buffer_count">
			<return type="void" />
			<param index="0" name="plane_polygon_buffer_count" type="int" />
			<description>
				Sets the plane's polygon buffer count.
			</description>
		</method>
		<method name="get_plane_id" qualifiers="const">
			<return type="int" />
			<description>
				Gets the plane's ID.
			</description>
		</method>
		<method name="get_plane_space_location_flags" qualifiers="const">
			<return type="int" enum="OpenXRExtPlaneTracker.PlaneSpaceLocationFlags"
				is_bitfield="true" />
			<description>
				Gets the plane's space location flags, which determines whether position and orientation are tracked and whether they are valid.
				This information has been OR'ed into the returned bit field.		
			</description>
		</method>
		<method name="get_plane_position" qualifiers="const">
			<return type="Vector3" />
			<description>
				Gets the plane's position.
			</description>
		</method>
		<method name="get_plane_rotation" qualifiers="const">
			<return type="Quaternion" />
			<description>
				Gets the plane's rotation.
			</description>
		</method>
		<method name="get_plane_width" qualifiers="const">
			<return type="float" />
			<description>
				Gets the plane's width in meters.
			</description>
		</method>
		<method name="get_plane_height" qualifiers="const">
			<return type="float" />
			<description>
				Gets the plane's height in meters.
			</description>
		</method>
		<method name="get_plane_orientation" qualifiers="const">
			<return type="int" enum="OpenXRExtPlaneTracker.PlaneOrientation" />
			<description>
				Gets the plane's orientation.
			</description>
		</method>
		<method name="get_plane_semantic_type" qualifiers="const">
			<return type="int" enum="OpenXRExtPlaneTracker.PlaneSemanticType" />
			<description>
				Gets the plane's semantic type.
			</description>
		</method>
		<method name="get_plane_polygon_buffer_count" qualifiers="const">
			<return type="int" />
			<description>
				Gets the plane's polygon buffer count.
			</description>
		</method>
		<method name="get_plane_polygon_buffers" qualifiers="const">
			<return type="Array" />
			<description>
				Gets the plane's polygon buffers.
			</description>
		</method>
	</methods>
	<signals>
		<signal name="openxr_plane_updated">
			<description>
				Emitted when the plane is successfully updated.
			</description>
		</signal>
		<signal name="openxr_plane_polygon_updated">
			<description>
				Emitted when one of the plane polygons is successfully updated.
			</description>
		</signal>
	</signals>
	<constants>
		<constant name="PLANE_ORIENTATION_HORIZONTAL_UPWARD" value="0" enum="PlaneOrientation">
			The plane's orientation is horizontal upward.
		</constant>
		<constant name="PLANE_ORIENTATION_HORIZONTAL_DOWNWARD" value="1" enum="PlaneOrientation">
			The plane's orientation is horizontal downward.
		</constant>
		<constant name="PLANE_ORIENTATION_VERTICAL" value="2" enum="PlaneOrientation">
			The plane's orientation is vertical.
		</constant>
		<constant name="PLANE_ORIENTATION_ARBITRARY" value="3" enum="PlaneOrientation">
			The plane's orientation is arbitrary.
		</constant>
		<constant name="PLANE_ORIENTATION_MAX_ENUM" value="4" enum="PlaneOrientation">
			Maximum value for the plane orientation enum.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_UNDEFINED" value="0" enum="PlaneSemanticType">
			The plane's semantic type is unknown.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_CEILING" value="1" enum="PlaneSemanticType">
			The plane's semantic type is ceiling.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_FLOOR" value="2" enum="PlaneSemanticType">
			The plane's semantic type is floor.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_WALL" value="3" enum="PlaneSemanticType">
			The plane's semantic type is wall.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_PLATFORM" value="4" enum="PlaneSemanticType">
			The plane's semantic type is platform.
		</constant>
		<constant name="PLANE_SEMANTIC_TYPE_MAX_ENUM" value="5" enum="PlaneSemanticType">
			Maximum value for the plane's semantic type.
		</constant>
		<constant name="PLANE_SPACE_LOCATION_ORIENTATION_VALID_BIT" value="1"
			enum="PlaneSpaceLocationFlags">
			The plane's semantic type is unknown.
		</constant>
		<constant name="PLANE_SPACE_LOCATION_POSITION_VALID_BIT" value="2"
			enum="PlaneSpaceLocationFlags">
			The plane's semantic type is ceiling.
		</constant>
		<constant name="PLANE_SPACE_LOCATION_ORIENTATION_TRACKED_BIT" value="4"
			enum="PlaneSpaceLocationFlags">
			The plane's semantic type is floor.
		</constant>
		<constant name="PLANE_SPACE_LOCATION_POSITION_TRACKED_BIT" value="8"
			enum="PlaneSpaceLocationFlags">
			The plane's semantic type is wall.
		</constant>
	</constants>
</class>